### SMM Mastery .env example
# Copy this file to .env and fill the values. Keep .env out of version control.

# Site
SITE_URL=http://localhost/smm
SITE_EMAIL=admin@example.com

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# CoinPayments
COINPAYMENTS_MERCHANT_ID=
COINPAYMENTS_IPN_SECRET=

# CoinGate
COINGATE_API_KEY=
COINGATE_APP_ID=

# BTCPay
BTCPAY_SERVER_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# SMMFollows provider
SMMFOLLOWS_API_KEY=

# PayPal
PAYPAL_EMAIL=
PAYPAL_MODE=sandbox

# Stripe
STRIPE_SECRET_KEY=

# Provider payment details (auto-credit)
PROVIDER_PAYPAL_EMAIL=
PROVIDER_STRIPE_ACCOUNT=

# Crypto / Gateway defaults
CRYPTO_GATEWAY=nowpayments
CRYPTO_CURRENCY=USDT
NOWPAYMENTS_API_KEY=

# Auto-credit and thresholds
AUTO_CREDIT_MODE=queue_only
PROVIDER_BALANCE_ALERT_THRESHOLD=25.00

